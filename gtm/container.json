      {
        "accountId": "0",
        "containerId": "0",
        "tagId": "15",
        "name": "HTML - Rastreamento de scroll e secoes",
        "type": "html",
        "parameter": [
          {
            "type": "TEMPLATE",
            "key": "html",
            "value": "<script>\n(function () {\n  if (window.__culpadoScroll) return;\n  window.__culpadoScroll = true;\n\n  var MARCOS = [10, 25, 50, 75, 90, 100];\n  var SECOES = ['lances', 'cap-jogo', 'cap-janela', 'cap-draft', 'cap-rotas', 'cap-itens', 'cap-tribunal', 'cap-time'];\n  var ALTURA_MINIMA_PARTIDA = 5000; // ignora a tela enquanto a partida carrega\n  var visaoAtual = null, marcosVistos = {}, secoesVistas = {}, agendado = false;\n\n  function tipoPagina() {\n    if (location.pathname.indexOf('/ranking') === 0) return 'ranking';\n    return /^#\\d{6,}/.test(location.hash) ? 'partida' : 'home';\n  }\n\n  function enviar(evento, dados) {\n    dados.event = evento;\n    dados.page_type = tipoPagina();\n    window.dataLayer.push(dados);\n  }\n\n  function medir() {\n    agendado = false;\n    var visao = location.pathname + (location.hash.match(/^#\\d{6,}/) || [''])[0];\n    if (visao !== visaoAtual) { visaoAtual = visao; marcosVistos = {}; secoesVistas = {}; }\n\n    var alturaTela = window.innerHeight;\n    var alturaTotal = document.documentElement.scrollHeight;\n    var maximo = alturaTotal - alturaTela;\n    if (maximo <= 0) return;\n    if (tipoPagina() === 'partida' && alturaTotal < ALTURA_MINIMA_PARTIDA) return;\n\n    var pct = Math.ceil(window.scrollY / maximo * 100);\n    MARCOS.forEach(function (marco) {\n      if (pct >= marco && !marcosVistos[marco]) {\n        marcosVistos[marco] = true;\n        enviar('scroll_depth', { percent_scrolled: marco, section_id: undefined });\n      }\n    });\n\n    if (tipoPagina() !== 'partida') return;\n    var meio = alturaTela / 2;\n    SECOES.forEach(function (id) {\n      var el = document.getElementById(id);\n      if (!el || secoesVistas[id]) return;\n      var r = el.getBoundingClientRect();\n      if (r.top <= meio && r.bottom >= meio) {\n        secoesVistas[id] = true;\n        enviar('section_view', { section_id: id, percent_scrolled: undefined });\n      }\n    });\n  }\n\n  window.addEventListener('scroll', function () {\n    if (agendado) return;\n    agendado = true;\n    window.requestAnimationFrame(medir);\n  }, { passive: true });\n})();\n</script>"
